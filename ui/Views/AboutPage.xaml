<Page x:Class="AgentToolkit.Ui.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Padding="28,20,28,28" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="关于" Style="{ThemeResource TitleTextBlockStyle}" />
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Jailbreak Tool" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock Text="工具不联网、不上报数据，全部作用域为本机文件。单文件引擎 engine.exe 与本界面共用同一套核心库，界面只通过冻结的 C# 接口 IAgentEngine 对接。" TextWrapping="Wrap" /><TextBlock Text="模型不是在坚持立场，是在现场找依据：控制它看到的依据，就控制了它的结论。所以这里只做两件事——改它读到的系统提示词，和改它读到的上下文指令文件。" TextWrapping="Wrap" /></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="支持的目标" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock Text="DeepSeek Harness：打包 Electron，系统层走 profile 补丁层的 row 覆写（含 preset 覆写），载荷层写 $DSH_HOME\AGENTS.md（有效上限 64 KB）。" TextWrapping="Wrap" /><TextBlock Text="ZCode：提示词明文在 resources\glm\zcode.cjs，系统层走五道字符串补丁，载荷层写 ~/.zcode/AGENTS.md（上限 100 KB）。" TextWrapping="Wrap" /><TextBlock Text="opencode：客户端里没有可删的安全条款，注入走官方配置通道。三层权力递减——系统层 agent.&lt;名字&gt;.prompt 被当硬性规定执行，配置指令层 opencode.json 的 instructions 会被归类成「文件」，载荷层 AGENTS.md 甚至被模型点名驳回为「本机偏好」；生效证据看 instruction_blob。" TextWrapping="Wrap" /><TextBlock Text="在左侧栏切换目标；切换后所有页面都作用于新目标。未安装的目标会标注出来，仍可查看它的路径探测与锚点状态。" TextWrapping="Wrap" /></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="两套注入方案（可切换）" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock Text="三个目标（DSH / ZCode / opencode）各有两套注入文本，在注入页切换；切换后注入、预览、还原、状态全部作用于当前方案。" TextWrapping="Wrap" /><TextBlock Text="A 套 own（本工具方案）：环境事实 + 交付偏好，属于「陈述型」——模型可以把它归类成某人的偏好，于是可以评价、可以驳回（opencode 实测被点名驳回为「本机偏好」）。" TextWrapping="Wrap" /><TextBlock Text="B 套 protocol（gpt-instruct 方案）：上游项目的提示词原文，逐字节不动，属于「协议型」——它规定本轮请求如何被处理（状态绑定、输出契约前置、禁止替代品、完成度约束），通篇不提允许/安全/破例，所以没有可驳回的对象。" TextWrapping="Wrap" /><TextBlock Text="实现：契约里 SavePolicyFileAsync 的名字是自由字符串，所以用保留名 scheme（own / protocol）当选择器，落盘 &lt;数据目录&gt;\policy\scheme.txt；GetPolicyFilesAsync 把它作为只读条目返回。文件不存在就是 own，现有安装行为不变。B 套的原文 sha256 在自检里断言，用来证明原文没被动过。" TextWrapping="Wrap" /></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="硬性边界" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock Text="不绕过服务端审核：本地改动只影响本地客户端发出的请求，服务端若另有一层过滤，本地改动对它无效。" TextWrapping="Wrap" /><TextBlock Text="不针对任何第三方系统：全部改动落在本机自己的客户端文件与配置上。" TextWrapping="Wrap" /><TextBlock Text="换模型可能失效：约束若被内化进训练而不是写成条款，改上下文与 persona 都无效，此时唯一的杠杆是换模型。" TextWrapping="Wrap" /><TextBlock Text="区分「装上了」和「生效了」：状态页分别报告安装状态与会话中的生效证据，命中 0 就是没生效。" TextWrapping="Wrap" /></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="版本与部署" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock Text="WinUI 3 / Windows App SDK · C# / .NET 8 · 未打包自包含部署" TextWrapping="Wrap" /><TextBlock Text="发布物为完整文件夹。界面与后端之间只有 Services\ServiceLocator.cs 一个替换入口。" TextWrapping="Wrap" /></StackPanel></Border>
    </StackPanel></ScrollViewer>
</Page>
