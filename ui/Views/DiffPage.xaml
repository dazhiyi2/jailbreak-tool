<Page x:Class="AgentToolkit.Ui.Views.DiffPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:AgentToolkit.Ui.Controls">
    <ScrollViewer><StackPanel Padding="28,20,28,28" Spacing="16">
        <Grid><StackPanel Spacing="4"><TextBlock Text="差异对照" Style="{ThemeResource TitleTextBlockStyle}" /><TextBlock Text="按来源比较系统提示词；绿色为新增，红色为删除，灰色为上下文。" Style="{StaticResource MutedTextStyle}" /></StackPanel><Button Content="刷新差异" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" /></Grid>
        <controls:PageFeedback />
        <StackPanel Spacing="16" Visibility="{Binding ContentVisibility}">
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Text="变更前来源" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding BeforeSource}" Style="{StaticResource MonoTextStyle}" /><TextBlock Text="变更后来源" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding AfterSource}" Style="{StaticResource MonoTextStyle}" /><TextBlock Text="{Binding Summary}" FontWeight="SemiBold" /></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}">
                <ListView ItemsSource="{Binding Lines}" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate><Grid Padding="4,6" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Left}" Style="{StaticResource MonoTextStyle}" /><TextBlock Grid.Column="1" Text="{Binding Right}" Style="{StaticResource MonoTextStyle}" /><TextBlock Grid.Column="2" Text="{Binding Sign}" Style="{StaticResource MonoTextStyle}" /><controls:StatusBadge Grid.Column="3" Text="{Binding Text}" Tone="{Binding Tone}" /></Grid></DataTemplate></ListView.ItemTemplate>
                </ListView>
            </Border>
            <TextBlock Text="标记变化" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{Binding Markers}" ItemTemplate="{StaticResource MarkerTemplate}" SelectionMode="None" />
        </StackPanel>
    </StackPanel></ScrollViewer>
</Page>
