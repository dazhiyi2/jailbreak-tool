<Page x:Class="AgentToolkit.Ui.Views.LocatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:AgentToolkit.Ui.Controls">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,28" Spacing="16">
            <TextBlock Text="探测与诊断" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="从明确路径逐级探测，保留每一条候选与命中结果。" Style="{StaticResource MutedTextStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <ContentControl IsEnabled="{Binding IsInteractive}" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                    <TextBox Header="手动指定安装根路径" PlaceholderText="留空时由引擎自动定位" Text="{Binding ExplicitRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="手动指定配置根路径" PlaceholderText="可选" Text="{Binding ExplicitConfigHome, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <ToggleSwitch Header="忽略记忆路径" OnContent="已开启" OffContent="已关闭" IsOn="{Binding IgnoreMemory, Mode=TwoWay}" />
                        <ToggleSwitch Header="全盘嗅探" OnContent="已开启" OffContent="已关闭" IsOn="{Binding FullSniff, Mode=TwoWay}" />
                        <Button Content="开始探测 / 重试" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel></ContentControl>
            </Border>
            <controls:PageFeedback />
            <StackPanel Spacing="16" Visibility="{Binding ContentVisibility}">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TargetName}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <controls:StatusBadge Grid.Column="1" Text="{Binding KindLabel}" Tone="Neutral" />
                        </Grid>
                        <TextBlock Text="{Binding ClassNote}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" /><TextBlock Text="{Binding TargetRoot}" Style="{StaticResource MonoTextStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <Grid Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock Text="探测级别" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="候选路径 / 诊断" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="命中结果" FontWeight="SemiBold" /></Grid>
                        <ListView ItemsSource="{Binding Attempts}" SelectionMode="None">
                            <ListView.ItemTemplate><DataTemplate>
                                <Grid Padding="8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Level}" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Candidate}" Style="{StaticResource MonoTextStyle}" /><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}" /></StackPanel><controls:StatusBadge Grid.Column="2" Text="{Binding Hit}" Tone="{Binding Tone}" />
                                </Grid>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
                <TextBlock Text="全盘嗅探候选" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{Binding SniffSummary}" Style="{StaticResource MutedTextStyle}" />
                <ListView ItemsSource="{Binding SniffCandidates}" SelectionMode="None" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
