<Page x:Class="AgentToolkit.Ui.Views.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:AgentToolkit.Ui.Controls">
    <Grid Padding="28,20,28,28" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><StackPanel Spacing="4"><TextBlock Text="日志查看器" Style="{ThemeResource TitleTextBlockStyle}" /><TextBlock Text="搜索已载入的推理原文，按轮次定位；可复制全部或选中文本。" Style="{StaticResource MutedTextStyle}" /></StackPanel><Button Content="刷新会话" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" /></Grid>
        <controls:PageFeedback Grid.Row="1" />
        <Expander Grid.Row="2" Header="已导出文件" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="10"><TextBlock Text="{Binding ExportSummary}" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="导出会话原文" Command="{Binding ExportSessionCommand}" /><Button Content="导出系统提示词" Command="{Binding ExportSystemCommand}" /><Button Content="打开已导出的会话文件" Command="{Binding OpenJsonlCommand}" /><Button Content="打开已导出的系统提示词" Command="{Binding OpenSystemCommand}" /></StackPanel></StackPanel>
        </Expander>
        <Grid Grid.Row="3" ColumnSpacing="16" Visibility="{Binding ContentVisibility}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="10">
                <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="会话列表" Margin="8" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ListView Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}" IsEnabled="{Binding IsInteractive}">
                        <ListView.ItemTemplate><DataTemplate><StackPanel Padding="4,8" Spacing="6"><TextBlock Text="{Binding Modified}" FontWeight="SemiBold" /><TextBlock Text="{Binding Id}" Style="{StaticResource MonoTextStyle}" /><TextBlock Text="{Binding Summary}" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding Workspace}" Style="{StaticResource MutedTextStyle}" /></StackPanel></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12"><StackPanel Spacing="6"><TextBlock Text="{Binding SessionSummary}" TextWrapping="Wrap" FontWeight="SemiBold" /><ListView ItemsSource="{Binding Markers}" ItemTemplate="{StaticResource MarkerTemplate}" SelectionMode="None" MaxHeight="150" /><TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" FontWeight="SemiBold" /></StackPanel></Border>
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ListView ItemsSource="{Binding Turns}" SelectedItem="{Binding SelectedTurn, Mode=TwoWay}">
                        <ListView.ItemTemplate><DataTemplate><StackPanel Padding="2,6" Spacing="6"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" /><TextBlock Text="{Binding At}" Style="{StaticResource MutedTextStyle}" FontSize="11" /></StackPanel></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Column="1" RowSpacing="6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox PlaceholderText="搜索全部已载入推理原文" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Content="上一处" Command="{Binding PreviousMatchCommand}" /><Button Grid.Column="2" Content="下一处" Command="{Binding NextMatchCommand}" /></Grid>
                        <TextBlock Grid.Row="1" Text="{Binding SearchSummary}" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                        <TextBlock Grid.Row="2" Text="{Binding SearchExcerpt}" TextWrapping="Wrap" MaxHeight="44" IsTextSelectionEnabled="True" FontSize="12" />
                        <InfoBar Grid.Row="3" IsOpen="{Binding IsTruncated}" IsClosable="False" Severity="Warning" Title="文本已截断" Message="引擎按加载上限返回了部分文本，搜索仅覆盖这些内容。" />
                        <TabView Grid.Row="4" IsAddTabButtonVisible="False" CanReorderTabs="False" CanDragTabs="False" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
                            <TabViewItem Header="推理原文" IsClosable="False"><controls:ReadOnlyTextView Text="{Binding ReasoningText}" MatchStart="{Binding MatchStart}" MatchLength="{Binding MatchLength}" /></TabViewItem>
                            <TabViewItem Header="回复文本" IsClosable="False"><controls:ReadOnlyTextView Text="{Binding ReplyText}" /></TabViewItem>
                            <TabViewItem Header="系统提示词" IsClosable="False"><controls:ReadOnlyTextView Text="{Binding SystemPromptText}" /></TabViewItem>
                        </TabView>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
