<Page x:Class="AgentToolkit.Ui.Views.ProbesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:AgentToolkit.Ui.Controls">
    <ScrollViewer><StackPanel Padding="28,20,28,28" Spacing="16">
        <Grid><StackPanel Spacing="4"><TextBlock Text="验收台账" Style="{ThemeResource TitleTextBlockStyle}" /><TextBlock Text="依据推理原文人工登记结果，保留摘录、关联会话与历史。" Style="{StaticResource MutedTextStyle}" /></StackPanel><Button Content="刷新台账" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" /></Grid>
        <controls:PageFeedback />
        <StackPanel Spacing="16" Visibility="{Binding ContentVisibility}">
            <Border Style="{StaticResource CardStyle}"><ContentControl IsEnabled="{Binding IsInteractive}" HorizontalContentAlignment="Stretch"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ListView ItemsSource="{Binding Probes}" SelectedItem="{Binding SelectedProbe, Mode=TwoWay}"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="4,8" Spacing="6"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><controls:StatusBadge Text="分水岭项" Tone="Warning" Visibility="{Binding DecisiveVisibility}" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Text="操作说明" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding HowTo}" TextWrapping="Wrap" />
                    <TextBlock Text="判定标准" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding Criteria}" TextWrapping="Wrap" />
                    <ComboBox Header="三级判定" PlaceholderText="请选择人工判定" ItemsSource="{Binding Levels}" SelectedIndex="{Binding SelectedLevel, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <TextBox Header="推理原文摘录（必填）" PlaceholderText="粘贴已有会话中的原文证据" Text="{Binding ReasoningExcerpt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" />
                    <TextBox Header="关联会话编号（可选）" Text="{Binding SessionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="备注（可选）" Text="{Binding NoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="保存判定记录" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid></ContentControl></Border>
            <TextBlock Text="历史记录" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <InfoBar IsOpen="{Binding HistoryEmpty}" IsClosable="False" Title="暂无历史记录" Message="选择探针、人工判定并填写原文摘录后保存第一条记录。" />
            <ListView ItemsSource="{Binding Verdicts}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Margin="0,0,0,8"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="20"><TextBlock Text="{Binding Probe}" FontWeight="SemiBold" /><TextBlock Text="{Binding Level}" /><TextBlock Text="{Binding At}" Style="{StaticResource MutedTextStyle}" /></StackPanel><TextBlock Text="{Binding Excerpt}" Style="{StaticResource MonoTextStyle}" /><TextBlock Text="{Binding Session}" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding Note}" Style="{StaticResource MutedTextStyle}" /></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
        </StackPanel>
    </StackPanel></ScrollViewer>
</Page>
